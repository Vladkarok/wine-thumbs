+/* The size the user last gave the dialog, kept in 96 DPI pixels; like
+ * Windows the dialog opens that big next time, centered where it was placed. */
+static void restore_dialog_size(FileDialogImpl *This)
+{
+    MONITORINFO info = { sizeof(info) };
+    DWORD size[2], len = sizeof(size);
+    int cx, cy, x, y;
+    RECT rc;
+
+    if (RegGetValueW(HKEY_CURRENT_USER, L"Software\\Wine\\FileDialog", L"ItemDialogSize", RRF_RT_REG_BINARY,
+            NULL, size, &len) || len != sizeof(size))
+        return;
+    if (!GetWindowRect(This->dlg_hwnd, &rc)
+            || !GetMonitorInfoW(MonitorFromWindow(This->dlg_hwnd, MONITOR_DEFAULTTONEAREST), &info))
+        return;
+
+    cx = max(rc.right - rc.left, min(MulDiv(size[0], This->dpi_x, USER_DEFAULT_SCREEN_DPI),
+                                     info.rcWork.right - info.rcWork.left));
+    cy = max(rc.bottom - rc.top, min(MulDiv(size[1], This->dpi_y, USER_DEFAULT_SCREEN_DPI),
+                                     info.rcWork.bottom - info.rcWork.top));
+    x = max(info.rcWork.left, min((int)(rc.left + rc.right - cx) / 2, (int)info.rcWork.right - cx));
+    y = max(info.rcWork.top, min((int)(rc.top + rc.bottom - cy) / 2, (int)info.rcWork.bottom - cy));
+    SetWindowPos(This->dlg_hwnd, NULL, x, y, cx, cy, SWP_NOZORDER | SWP_NOACTIVATE);
+}
+
+static void save_dialog_size(FileDialogImpl *This)
+{
+    DWORD size[2];
+    RECT rc;
+
+    if (IsZoomed(This->dlg_hwnd) || IsIconic(This->dlg_hwnd) || !GetWindowRect(This->dlg_hwnd, &rc)) return;
+    size[0] = MulDiv(rc.right - rc.left, USER_DEFAULT_SCREEN_DPI, This->dpi_x);
+    size[1] = MulDiv(rc.bottom - rc.top, USER_DEFAULT_SCREEN_DPI, This->dpi_y);
+    RegSetKeyValueW(HKEY_CURRENT_USER, L"Software\\Wine\\FileDialog", L"ItemDialogSize", REG_BINARY, size, sizeof(size));
+}
