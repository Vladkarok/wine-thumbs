+/* size a toolbar to its buttons */
+static void fit_toolbar(HWND toolbar)
+{
+    int count = SendMessageW(toolbar, TB_BUTTONCOUNT, 0, 0);
+    RECT rc;
+
+    if (count && SendMessageW(toolbar, TB_GETITEMRECT, count - 1, (LPARAM)&rc))
+        SetWindowPos(toolbar, NULL, 0, 0, rc.right, rc.bottom, SWP_NOMOVE | SWP_NOZORDER | SWP_NOACTIVATE);
+}
+
+/*
+ * An address box showing the current folder, which also takes a path to
+ * go to, and a toolbar with New folder and a view menu, like the command
+ * bar of the Windows dialog.
+ */
+static void init_address_and_commands(FileDialogImpl *This, HWND hwnd, int view_images, int button_size)
+{
+    TBBUTTON button[2];
+    HWND toolbar, address;
+    HIMAGELIST images;
+    int glyph;
+
+    address = CreateWindowExW(WS_EX_CLIENTEDGE, WC_EDITW, NULL, WS_CHILD | WS_VISIBLE | WS_TABSTOP | ES_AUTOHSCROLL,
+                              0, 0, 0, 0, hwnd, (HMENU)IDC_NAVADDRESS, COMDLG32_hInstance, NULL);
+    SendMessageW(address, WM_SETFONT, SendMessageW(hwnd, WM_GETFONT, 0, 0), FALSE);
+
+    toolbar = CreateWindowExW(0, TOOLBARCLASSNAMEW, NULL, TBSTYLE_FLAT | TBSTYLE_TOOLTIPS | WS_CHILD | WS_VISIBLE
+                              | CCS_NORESIZE | CCS_NOPARENTALIGN | CCS_NODIVIDER,
+                              0, 0, 0, 0, hwnd, (HMENU)IDC_CMD_TOOLBAR, NULL, NULL);
+    SendMessageW(toolbar, TB_SETEXTENDEDSTYLE, 0, TBSTYLE_EX_DRAWDDARROWS);
+
+    /* share the large view images of the navigation toolbar */
+    images = (HIMAGELIST)SendDlgItemMessageW(hwnd, IDC_NAV_TOOLBAR, TB_GETIMAGELIST, 0, 0);
+    SendMessageW(toolbar, TB_SETIMAGELIST, 0, (LPARAM)images);
+    glyph = COMDLG32_AddThumbnailsGlyph(images);
+
+    memset(button, 0, sizeof(button));
+    button[0].iBitmap = view_images + VIEW_NEWFOLDER;
+    button[0].idCommand = IDC_NEWFOLDER;
+    button[0].fsState = TBSTATE_ENABLED;
+    button[0].fsStyle = BTNS_BUTTON;
+    button[1].iBitmap = glyph >= 0 ? glyph : view_images + VIEW_LARGEICONS;
+    button[1].idCommand = IDC_VIEWMENU;
+    button[1].fsState = TBSTATE_ENABLED;
+    button[1].fsStyle = BTNS_WHOLEDROPDOWN;
+    SendMessageW(toolbar, TB_ADDBUTTONSW, ARRAY_SIZE(button), (LPARAM)button);
+    SendMessageW(toolbar, TB_SETBUTTONSIZE, 0, MAKELPARAM(button_size, button_size));
+    SendMessageW(toolbar, TB_AUTOSIZE, 0, 0);
+    fit_toolbar(toolbar);
+}
+
+static void update_address(FileDialogImpl *This)
+{
+    WCHAR *name;
+
+    if (!This->dlg_hwnd || !This->psi_folder) return;
+    if (FAILED(IShellItem_GetDisplayName(This->psi_folder, SIGDN_DESKTOPABSOLUTEEDITING, &name))) return;
+    SetDlgItemTextW(This->dlg_hwnd, IDC_NAVADDRESS, name);
+    CoTaskMemFree(name);
+}
+
+/* Enter in the address box: go to the folder typed there */
+static void on_address_enter(FileDialogImpl *This)
+{
+    WCHAR text[MAX_PATH], *current, path[MAX_PATH];
+    ITEMIDLIST *pidl = NULL;
+    SFGAOF attributes = SFGAO_FOLDER;
+
+    if (!GetDlgItemTextW(This->dlg_hwnd, IDC_NAVADDRESS, text, ARRAY_SIZE(text))) return;
+
+    /* relative paths start from the current folder, not from the desktop */
+    if (PathIsRelativeW(text) && wcsncmp(text, L"::", 2) && This->psi_folder
+            && SUCCEEDED(IShellItem_GetDisplayName(This->psi_folder, SIGDN_FILESYSPATH, &current)))
+    {
+        if (PathCombineW(path, current, text) && FAILED(SHParseDisplayName(path, NULL, &pidl, SFGAO_FOLDER, &attributes)))
+            pidl = NULL;
+        CoTaskMemFree(current);
+    }
+    if (!pidl && FAILED(SHParseDisplayName(text, NULL, &pidl, SFGAO_FOLDER, &attributes)))
+        pidl = NULL;
+
+    if (pidl && (attributes & SFGAO_FOLDER))
+    {
+        IShellView *view;
+
+        IExplorerBrowser_BrowseToIDList(This->peb, pidl, SBSP_ABSOLUTE);
+        /* like Explorer, continue in the file list */
+        if (SUCCEEDED(IExplorerBrowser_GetCurrentView(This->peb, &IID_IShellView, (void **)&view)))
+        {
+            HWND view_hwnd;
+
+            if (SUCCEEDED(IShellView_GetWindow(view, &view_hwnd))) SetFocus(view_hwnd);
+            IShellView_Release(view);
+        }
+    }
+    else
+    {
+        MessageBeep(MB_ICONWARNING);
+        update_address(This);
+    }
+    ILFree(pidl);
+}
+
+static void on_new_folder(FileDialogImpl *This)
+{
+    CMINVOKECOMMANDINFO info;
+    IContextMenu *menu;
+    IShellView *view;
+    HWND view_hwnd;
+
+    if (FAILED(IExplorerBrowser_GetCurrentView(This->peb, &IID_IShellView, (void **)&view))) return;
+    if (SUCCEEDED(IShellView_GetItemObject(view, SVGIO_BACKGROUND, &IID_IContextMenu, (void **)&menu)))
+    {
+        memset(&info, 0, sizeof(info));
+        info.cbSize = sizeof(info);
+        IShellView_GetWindow(view, &view_hwnd);
+        info.hwnd = GetParent(view_hwnd);
+        info.lpVerb = CMDSTR_NEWFOLDERA;
+        IContextMenu_InvokeCommand(menu, &info);
+        IContextMenu_Release(menu);
+    }
+    IShellView_Release(view);
+}
+
+static void show_view_menu(FileDialogImpl *This, const NMTOOLBARW *nmtb)
+{
+    static const struct { UINT mode, string; } modes[] =
+    {
+        { FVM_THUMBNAIL, IDS_THUMBNAILVIEW },
+        { FVM_LIST, IDS_LISTVIEW },
+        { FVM_DETAILS, IDS_REPORTVIEW },
+    };
+    IFolderView *view;
+    UINT i, mode = 0, chosen;
+    WCHAR text[64];
+    HMENU menu;
+    POINT pt;
+
+    if (FAILED(IExplorerBrowser_GetCurrentView(This->peb, &IID_IFolderView, (void **)&view))) return;
+    IFolderView_GetCurrentViewMode(view, &mode);
+
+    menu = CreatePopupMenu();
+    for (i = 0; i < ARRAY_SIZE(modes); i++)
+    {
+        LoadStringW(COMDLG32_hInstance, modes[i].string, text, ARRAY_SIZE(text));
+        AppendMenuW(menu, MF_STRING, modes[i].mode, text);
+    }
+    for (i = 0; i < ARRAY_SIZE(modes); i++)
+        if (modes[i].mode == mode) CheckMenuRadioItem(menu, 0, ARRAY_SIZE(modes) - 1, i, MF_BYPOSITION);
+
+    pt.x = nmtb->rcButton.left;
+    pt.y = nmtb->rcButton.bottom;
+    ClientToScreen(nmtb->hdr.hwndFrom, &pt);
+    chosen = TrackPopupMenu(menu, TPM_RETURNCMD | TPM_LEFTALIGN | TPM_TOPALIGN, pt.x, pt.y, 0, This->dlg_hwnd, NULL);
+    DestroyMenu(menu);
+
+    if (chosen) IFolderView_SetCurrentViewMode(view, chosen);
+    IFolderView_Release(view);
+}
+
+static LRESULT on_wm_notify(FileDialogImpl *This, NMHDR *hdr)
+{
+    switch (hdr->code)
+    {
+    case TBN_DROPDOWN:
+        if (((NMTOOLBARW *)hdr)->iItem == IDC_VIEWMENU)
+            show_view_menu(This, (NMTOOLBARW *)hdr);
+        break;
+    case TTN_GETDISPINFOW:
+    {
+        NMTTDISPINFOW *info = (NMTTDISPINFOW *)hdr;
+
+        info->hinst = COMDLG32_hInstance;
+        if (hdr->idFrom == IDC_NEWFOLDER) info->lpszText = MAKEINTRESOURCEW(IDS_NEWFOLDER);
+        else if (hdr->idFrom == IDC_VIEWMENU) info->lpszText = MAKEINTRESOURCEW(IDS_VIEW_MENU);
+        break;
+    }
+    }
+    return FALSE;
+}
