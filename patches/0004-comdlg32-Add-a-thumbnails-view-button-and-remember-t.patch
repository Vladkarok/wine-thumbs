+/***********************************************************************
+ *      File dialog view mode, shared by the Explorer and the item dialogs
+ */
+static const WCHAR filedlg_settings_key[] = L"Software\\Wine\\FileDialog";
+
+static BOOL is_remembered_view_mode(DWORD mode)
+{
+    return mode == FVM_ICON || mode == FVM_SMALLICON || mode == FVM_LIST
+            || mode == FVM_DETAILS || mode == FVM_THUMBNAIL;
+}
+
+UINT COMDLG32_GetFileDialogViewMode(UINT default_mode)
+{
+    DWORD mode, size = sizeof(mode);
+
+    if (RegGetValueW(HKEY_CURRENT_USER, filedlg_settings_key, L"ViewMode", RRF_RT_REG_DWORD, NULL, &mode, &size)
+            || !is_remembered_view_mode(mode))
+        return default_mode;
+    return mode;
+}
+
+/* Only a mode the user picked is stored, so the defaults of the two dialogs
+ * don't override each other. */
+void COMDLG32_SetFileDialogViewMode(UINT mode, UINT default_mode)
+{
+    DWORD value = mode;
+
+    if (!is_remembered_view_mode(mode) || COMDLG32_GetFileDialogViewMode(default_mode) == mode) return;
+    RegSetKeyValueW(HKEY_CURRENT_USER, filedlg_settings_key, L"ViewMode", REG_DWORD, &value, sizeof(value));
+}
+
+static void filedlg_set_view_mode(const FileOpenDlgInfos *info, UINT mode)
+{
+    IFolderView *view;
+
+    if (info->Shell.FOIShellView && SUCCEEDED(IShellView_QueryInterface(info->Shell.FOIShellView,
+            &IID_IFolderView, (void **)&view)))
+    {
+        IFolderView_SetCurrentViewMode(view, mode);
+        IFolderView_Release(view);
+    }
+}
+
+/* comctl32 has no thumbnails glyph: a 2x2 grid of little pictures, in the
+ * colours of the stock view glyphs */
+static int filedlg_add_thumbnails_glyph(HIMAGELIST list)
+{
+    static const char tile[7][8] = { "ooooooo", "ossssso", "ossssso", "ossssso", "ogggggo", "ogggggo", "ooooooo" };
+    BYTE mask[16 * 2] = { 0 };
+    BITMAPINFO info;
+    ICONINFO icon_info;
+    HICON icon;
+    DWORD *bits;
+    int x, y, index = -1;
+
+    memset(&info, 0, sizeof(info));
+    info.bmiHeader.biSize = sizeof(info.bmiHeader);
+    info.bmiHeader.biWidth = 16;
+    info.bmiHeader.biHeight = -16;
+    info.bmiHeader.biPlanes = 1;
+    info.bmiHeader.biBitCount = 32;
+    info.bmiHeader.biCompression = BI_RGB;
+
+    memset(&icon_info, 0, sizeof(icon_info));
+    icon_info.fIcon = TRUE;
+    if (!(icon_info.hbmColor = CreateDIBSection(NULL, &info, DIB_RGB_COLORS, (void **)&bits, NULL, 0))) return -1;
+
+    for (y = 0; y < 16; y++)
+    {
+        for (x = 0; x < 16; x++)
+        {
+            char c = (x % 9 < 7 && y % 9 < 7) ? tile[y % 9][x % 9] : 0;
+
+            switch (c)
+            {
+            case 'o': bits[y * 16 + x] = 0xff707070; break;
+            case 's': bits[y * 16 + x] = 0xff8ab4e0; break;
+            case 'g': bits[y * 16 + x] = 0xff7aab4f; break;
+            default:
+                bits[y * 16 + x] = 0;
+                mask[y * 2 + x / 8] |= 0x80 >> (x % 8);
+            }
+        }
+    }
+
+    if ((icon_info.hbmMask = CreateBitmap(16, 16, 1, 1, mask)) && (icon = CreateIconIndirect(&icon_info)))
+    {
+        index = ImageList_AddIcon(list, icon);
+        DestroyIcon(icon);
+    }
+    if (icon_info.hbmMask) DeleteObject(icon_info.hbmMask);
+    DeleteObject(icon_info.hbmColor);
+    return index;
+}
+
+/* The template reserves room for the stock toolbar buttons only; let the
+ * toolbar grow into the free space on its right so the last one is not cut. */
+static void filedlg_fit_toolbar(HWND hwnd, HWND toolbar)
+{
+    int count = SendMessageW(toolbar, TB_BUTTONCOUNT, 0, 0);
+    RECT button, rect, client;
+
+    if (!count || !SendMessageW(toolbar, TB_GETITEMRECT, count - 1, (LPARAM)&button)) return;
+    GetWindowRect(toolbar, &rect);
+    MapWindowPoints(0, hwnd, (POINT *)&rect, 2);
+    GetClientRect(hwnd, &client);
+    if (button.right <= rect.right - rect.left) return;
+
+    SetWindowPos(toolbar, 0, 0, 0, max(rect.right, min(rect.left + button.right, client.right)) - rect.left,
+            rect.bottom - rect.top, SWP_NOMOVE | SWP_NOZORDER | SWP_NOACTIVATE);
+}
