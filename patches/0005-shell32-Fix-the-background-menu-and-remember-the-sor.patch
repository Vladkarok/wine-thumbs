+/* dates and sizes start with the newest and biggest, like Explorer */
+static BOOL default_sort_ascending(int column)
+{
+    return column != LISTVIEW_COLUMN_TIME && column != LISTVIEW_COLUMN_SIZE;
+}
+
+/* show the sort column and direction in the header of the details view */
+static void ShellView_UpdateSortArrows(IShellViewImpl *This)
+{
+    HWND header = (HWND)SendMessageW(This->hWndList, LVM_GETHEADER, 0, 0);
+    int i, count;
+    HDITEMW item;
+
+    if (!header) return;
+    count = SendMessageW(header, HDM_GETITEMCOUNT, 0, 0);
+    for (i = 0; i < count; i++)
+    {
+        item.mask = HDI_FORMAT;
+        if (!SendMessageW(header, HDM_GETITEMW, i, (LPARAM)&item)) continue;
+        item.fmt &= ~(HDF_SORTUP | HDF_SORTDOWN);
+        if (i == This->ListViewSortInfo.nHeaderID)
+            item.fmt |= This->ListViewSortInfo.bIsAscending ? HDF_SORTUP : HDF_SORTDOWN;
+        SendMessageW(header, HDM_SETITEMW, i, (LPARAM)&item);
+    }
+}
+
+/* apply the current sort order, if the user picked one */
+static void ShellView_Sort(IShellViewImpl *This)
+{
+    if (This->ListViewSortInfo.nHeaderID < 0) return;
+    SendMessageW(This->hWndList, LVM_SORTITEMS, (WPARAM)&This->ListViewSortInfo, (LPARAM)ShellView_ListViewCompareItems);
+    ShellView_UpdateSortArrows(This);
+}
+
+/* sort by a column and remember it for this folder */
+static void ShellView_SetSort(IShellViewImpl *This, int column, BOOL ascending)
+{
+    This->ListViewSortInfo.nHeaderID = column;
+    This->ListViewSortInfo.nLastHeaderID = column;
+    This->ListViewSortInfo.bIsAscending = ascending;
+    ShellView_Sort(This);
+    folder_sort_save(This->sort_key, column, ascending);
+}
