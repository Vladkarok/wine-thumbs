+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#include <stdarg.h>
+#include <stdlib.h>
+
+#define COBJMACROS
+
+#include "windef.h"
+#include "winbase.h"
+#include "winreg.h"
+#include "objbase.h"
+#include "shlobj.h"
+#include "wine/debug.h"
+
+#include "shlview_sort.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(shell);
+
+#define MAX_FOLDERS 500
+
+static const WCHAR folder_sort_path[] = L"Software\\Wine\\Shell\\FolderSort";
+
+struct folder_sort
+{
+    DWORD column;
+    DWORD ascending;
+    FILETIME saved;
+};
+
+WCHAR *folder_sort_key(IShellFolder *folder)
+{
+    IPersistFolder2 *persist;
+    WCHAR *name, *key = NULL;
+    ITEMIDLIST *pidl;
+
+    if (FAILED(IShellFolder_QueryInterface(folder, &IID_IPersistFolder2, (void **)&persist)))
+        return NULL;
+    if (SUCCEEDED(IPersistFolder2_GetCurFolder(persist, &pidl)))
+    {
+        if (SUCCEEDED(SHGetNameFromIDList(pidl, SIGDN_DESKTOPABSOLUTEPARSING, &name)))
+        {
+            key = wcsdup(name);
+            CoTaskMemFree(name);
+        }
+        ILFree(pidl);
+    }
+    IPersistFolder2_Release(persist);
+    return key;
+}
+
+BOOL folder_sort_load(const WCHAR *key, int *column, BOOL *ascending)
+{
+    struct folder_sort sort;
+    DWORD size = sizeof(sort);
+
+    if (!key || RegGetValueW(HKEY_CURRENT_USER, folder_sort_path, key, RRF_RT_REG_BINARY, NULL, &sort, &size)
+            || size != sizeof(sort))
+        return FALSE;
+
+    TRACE("%s: column %lu, ascending %lu\n", debugstr_w(key), sort.column, sort.ascending);
+    *column = sort.column;
+    *ascending = !!sort.ascending;
+    return TRUE;
+}
+
+struct saved_folder
+{
+    WCHAR *name;
+    FILETIME saved;
+};
+
+static int __cdecl compare_saved(const void *a, const void *b)
+{
+    return CompareFileTime(&((const struct saved_folder *)a)->saved, &((const struct saved_folder *)b)->saved);
+}
+
+/* drop the folders sorted longest ago */
+static void prune_folders(HKEY hkey, DWORD count, DWORD max_name)
+{
+    struct saved_folder *folders;
+    struct folder_sort sort;
+    DWORD i, found = 0, drop, name_len, size;
+
+    if (!(folders = calloc(count, sizeof(*folders)))) return;
+    for (i = 0; i < count; i++)
+    {
+        if (!(folders[found].name = malloc((max_name + 1) * sizeof(WCHAR)))) break;
+        name_len = max_name + 1;
+        size = sizeof(sort);
+        if (RegEnumValueW(hkey, i, folders[found].name, &name_len, NULL, NULL, (BYTE *)&sort, &size)
+                || size != sizeof(sort))
+        {
+            free(folders[found].name);
+            continue;
+        }
+        folders[found++].saved = sort.saved;
+    }
+
+    qsort(folders, found, sizeof(*folders), compare_saved);
+    drop = found > MAX_FOLDERS * 9 / 10 ? found - MAX_FOLDERS * 9 / 10 : 0;
+    for (i = 0; i < found; i++)
+    {
+        if (i < drop) RegDeleteValueW(hkey, folders[i].name);
+        free(folders[i].name);
+    }
+    free(folders);
+}
+
+void folder_sort_save(const WCHAR *key, int column, BOOL ascending)
+{
+    struct folder_sort sort;
+    DWORD count, max_name;
+    HKEY hkey;
+
+    if (!key || RegCreateKeyExW(HKEY_CURRENT_USER, folder_sort_path, 0, NULL, 0, KEY_ALL_ACCESS, NULL, &hkey, NULL))
+        return;
+
+    TRACE("%s: column %d, ascending %d\n", debugstr_w(key), column, ascending);
+    sort.column = column;
+    sort.ascending = ascending;
+    GetSystemTimeAsFileTime(&sort.saved);
+    RegSetValueExW(hkey, key, 0, REG_BINARY, (const BYTE *)&sort, sizeof(sort));
+
+    if (!RegQueryInfoKeyW(hkey, NULL, NULL, NULL, NULL, NULL, NULL, &count, &max_name, NULL, NULL, NULL)
+            && count > MAX_FOLDERS)
+        prune_folders(hkey, count, max_name);
+    RegCloseKey(hkey);
+}
