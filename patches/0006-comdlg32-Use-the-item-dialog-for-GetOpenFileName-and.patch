+
+/* Windows 7 and later open the folder used last instead of lpstrInitialDir
+ * when an application passes the lpstrInitialDir it passed the first time,
+ * so a fixed initial folder does not make the user browse every time. */
+BOOL COMDLG32_UseLastFolder(const WCHAR *initdir, WCHAR *folder)
+{
+    static const WCHAR key[] = L"Software\\Wine\\FileDialog\\FirstFolder";
+    WCHAR module_path[MAX_PATH], first[MAX_PATH], *module_name;
+    DWORD size = sizeof(first);
+
+    if (!initdir || !*initdir || !GetModuleFileNameW(NULL, module_path, ARRAY_SIZE(module_path)))
+        return FALSE;
+    module_name = (module_name = wcsrchr(module_path, '\\')) ? module_name + 1 : module_path;
+
+    if (RegGetValueW(HKEY_CURRENT_USER, key, module_name, RRF_RT_REG_SZ, NULL, first, &size))
+    {
+        RegSetKeyValueW(HKEY_CURRENT_USER, key, module_name, REG_SZ, initdir, (lstrlenW(initdir) + 1) * sizeof(WCHAR));
+        return FALSE;
+    }
+    return !lstrcmpiW(first, initdir) && COMDLG32_GetLastFolder(folder);
+}
