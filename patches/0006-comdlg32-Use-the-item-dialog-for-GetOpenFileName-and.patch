+#define IDC_OPEN_DROPDOWN   1
+#define OPEN_ITEM_NORMAL    0
+#define OPEN_ITEM_READONLY  1
+
+static BOOL get_dword_setting(HKEY root, const WCHAR *path, const WCHAR *name, DWORD *value)
+{
+    DWORD size = sizeof(*value);
+
+    return !RegGetValueW(root, path, name, RRF_RT_REG_DWORD, NULL, value, &size);
+}
+
+static BOOL classic_dialog_wanted(void)
+{
+    WCHAR module[MAX_PATH], path[MAX_PATH + 64];
+    const WCHAR *name;
+    DWORD value;
+
+    if (GetModuleFileNameW(NULL, module, ARRAY_SIZE(module)))
+    {
+        name = (name = wcsrchr(module, '\\')) ? name + 1 : module;
+        swprintf(path, ARRAY_SIZE(path), L"Software\\Wine\\AppDefaults\\%s\\FileDialog", name);
+        if (get_dword_setting(HKEY_CURRENT_USER, path, L"Classic", &value)) return !!value;
+    }
+    return get_dword_setting(HKEY_CURRENT_USER, L"Software\\Wine\\FileDialog", L"Classic", &value) && value;
+}
+
+static BOOL use_item_dialog(const FileOpenDlgInfos *info)
+{
+    /* the item dialog has no way to host these */
+    if (info->ofnInfos->Flags & (OFN_ENABLEHOOK | OFN_ENABLETEMPLATE | OFN_ENABLETEMPLATEHANDLE | OFN_SHOWHELP))
+        return FALSE;
+    return !classic_dialog_wanted();
+}
+
+/* whether the current directory has files matching the filter */
+static BOOL current_dir_has_files(const WCHAR *filter)
+{
+    WIN32_FIND_DATAW data;
+    WCHAR spec[MAX_PATH], *next;
+    HANDLE find;
+
+    for (; filter && *filter; filter += lstrlenW(filter) + 1)
+    {
+        filter += lstrlenW(filter) + 1; /* skip the description */
+        if (!*filter) break;
+        lstrcpynW(spec, filter, ARRAY_SIZE(spec));
+        for (next = spec; next; )
+        {
+            WCHAR *pattern = next;
+
+            if ((next = wcschr(pattern, ';'))) *next++ = 0;
+            if ((find = FindFirstFileW(pattern, &data)) != INVALID_HANDLE_VALUE)
+            {
+                FindClose(find);
+                return TRUE;
+            }
+        }
+    }
+    return FALSE;
+}
+
+/*
+ * Where the dialog opens, following the Explorer style dialog:
+ *  1. the folder part of lpstrFile
+ *  2. the folder used last, when the application passes the initial folder
+ *     it passed the first time (Windows 7 and later), or none
+ *  3. lpstrInitialDir
+ *  4. the current directory, if it has files matching the filter
+ *  5. Documents
+ */
+static void get_initial_location(const FileOpenDlgInfos *info, WCHAR **folder, WCHAR **name)
+{
+    WCHAR path[MAX_PATH], last[MAX_PATH], *file_part;
+    BOOL has_initdir = info->initdir && *info->initdir;
+
+    *folder = *name = NULL;
+
+    if (info->filename && *info->filename)
+    {
+        if (wcspbrk(info->filename, L"\\/:") && GetFullPathNameW(info->filename, MAX_PATH, path, &file_part))
+        {
+            if (file_part)
+            {
+                *name = wcsdup(file_part);
+                *file_part = 0;
+            }
+            if (PathIsDirectoryW(path)) *folder = wcsdup(path);
+        }
+        else *name = wcsdup(info->filename);
+    }
+
+    if (*folder) return;
+
+    if (has_initdir ? COMDLG32_UseLastFolder(info->initdir, last) : COMDLG32_GetLastFolder(last))
+    {
+        *folder = wcsdup(last);
+        return;
+    }
+
+    if (has_initdir && GetFullPathNameW(info->initdir, MAX_PATH, path, NULL) && PathFileExistsW(path))
+    {
+        if (!PathIsDirectoryW(path)) PathRemoveFileSpecW(path);
+        *folder = wcsdup(path);
+        return;
+    }
+
+    if (current_dir_has_files(info->filter) && GetCurrentDirectoryW(MAX_PATH, path))
+        *folder = wcsdup(path);
+    else if (SHGetFolderPathW(NULL, CSIDL_PERSONAL, NULL, 0, path) == S_OK)
+        *folder = wcsdup(path);
+}
+
+/* "name\0spec\0...\0\0" into filter specs; the specs point into the strings */
+static COMDLG_FILTERSPEC *parse_filters(const WCHAR *custom, const WCHAR *filter, UINT *count, BOOL *has_custom)
+{
+    COMDLG_FILTERSPEC *specs;
+    const WCHAR *p;
+    UINT n = 0;
+
+    *count = 0;
+    *has_custom = custom && *custom && custom[lstrlenW(custom) + 1];
+    for (p = filter; p && *p; )
+    {
+        n++;
+        p += lstrlenW(p) + 1;
+        if (!*p) break; /* a name without a spec ends the list */
+        p += lstrlenW(p) + 1;
+    }
+    if (*has_custom) n++;
+    if (!n || !(specs = calloc(n, sizeof(*specs)))) return NULL;
+
+    if (*has_custom)
+    {
+        specs[*count].pszName = custom;
+        specs[(*count)++].pszSpec = custom + lstrlenW(custom) + 1;
+    }
+    for (p = filter; p && *p; )
+    {
+        specs[*count].pszName = p;
+        p += lstrlenW(p) + 1;
+        specs[(*count)++].pszSpec = p;
+        if (!*p) break;
+        p += lstrlenW(p) + 1;
+    }
+    return specs;
+}
+
+static void set_initial_folder(IFileDialog *dialog, const WCHAR *folder)
+{
+    IShellItem *item;
+
+    if (folder && SUCCEEDED(SHCreateItemFromParsingName(folder, NULL, &IID_IShellItem, (void **)&item)))
+    {
+        IFileDialog_SetFolder(dialog, item);
+        IShellItem_Release(item);
+    }
+}
+
+static void add_readonly_choice(IFileDialogCustomize *custom)
+{
+    WCHAR open[64], readonly[64];
+
+    LoadStringW(COMDLG32_hInstance, IDS_OPEN_BUTTON, open, ARRAY_SIZE(open));
+    LoadStringW(COMDLG32_hInstance, IDS_OPEN_READONLY, readonly, ARRAY_SIZE(readonly));
+    IFileDialogCustomize_EnableOpenDropDown(custom, IDC_OPEN_DROPDOWN);
+    IFileDialogCustomize_AddControlItem(custom, IDC_OPEN_DROPDOWN, OPEN_ITEM_NORMAL, open);
+    IFileDialogCustomize_AddControlItem(custom, IDC_OPEN_DROPDOWN, OPEN_ITEM_READONLY, readonly);
+}
+
+/* file system paths of the chosen items, all in the same folder */
+static WCHAR **get_result_paths(IFileDialog *dialog, BOOL multi, UINT *count)
+{
+    IFileOpenDialog *open_dialog;
+    IShellItemArray *array = NULL;
+    IShellItem *item;
+    WCHAR **paths = NULL;
+    DWORD n = 0, i;
+
+    *count = 0;
+    if (multi && SUCCEEDED(IFileDialog_QueryInterface(dialog, &IID_IFileOpenDialog, (void **)&open_dialog)))
+    {
+        if (FAILED(IFileOpenDialog_GetResults(open_dialog, &array))) array = NULL;
+        IFileOpenDialog_Release(open_dialog);
+    }
+
+    if (array)
+    {
+        if (SUCCEEDED(IShellItemArray_GetCount(array, &n)) && n && (paths = calloc(n, sizeof(*paths))))
+        {
+            for (i = 0; i < n; i++)
+            {
+                if (FAILED(IShellItemArray_GetItemAt(array, i, &item))) continue;
+                if (SUCCEEDED(IShellItem_GetDisplayName(item, SIGDN_FILESYSPATH, &paths[*count]))) (*count)++;
+                IShellItem_Release(item);
+            }
+        }
+        IShellItemArray_Release(array);
+    }
+    else if (SUCCEEDED(IFileDialog_GetResult(dialog, &item)))
+    {
+        if ((paths = calloc(1, sizeof(*paths))) && SUCCEEDED(IShellItem_GetDisplayName(item, SIGDN_FILESYSPATH, &paths[0])))
+            *count = 1;
+        IShellItem_Release(item);
+    }
+    return paths;
+}
+
+static void free_result_paths(WCHAR **paths, UINT count)
+{
+    UINT i;
+
+    for (i = 0; i < count; i++) CoTaskMemFree(paths[i]);
+    free(paths);
+}
+
+/*
+ * The result in lpstrFile: the full path, or for several files the folder
+ * followed by the file names, each NUL terminated, ending with an empty
+ * string. Returns the length including the terminators, and the offsets of
+ * the (first) file name and of its extension.
+ */
+static WCHAR *build_result(WCHAR **paths, UINT count, UINT *len, UINT *name_offset, UINT *ext_offset)
+{
+    WCHAR *result, *p, *ext;
+    UINT i, dir_len;
+
+    if (count == 1)
+    {
+        *len = lstrlenW(paths[0]) + 1;
+        if (!(result = malloc((*len + 1) * sizeof(WCHAR)))) return NULL;
+        lstrcpyW(result, paths[0]);
+        result[*len] = 0;
+        *name_offset = PathFindFileNameW(result) - result;
+        ext = PathFindExtensionW(result);
+        *ext_offset = *ext ? ext - result + 1 : 0;
+        return result;
+    }
+
+    dir_len = PathFindFileNameW(paths[0]) - paths[0];
+    if (dir_len > 1 && paths[0][dir_len - 1] == '\\' && paths[0][dir_len - 2] != ':') dir_len--;
+    *len = dir_len + 1;
+    for (i = 0; i < count; i++) *len += lstrlenW(PathFindFileNameW(paths[i])) + 1;
+    (*len)++;
+    if (!(result = malloc(*len * sizeof(WCHAR)))) return NULL;
+
+    memcpy(result, paths[0], dir_len * sizeof(WCHAR));
+    p = result + dir_len;
+    *p++ = 0;
+    for (i = 0; i < count; i++)
+    {
+        lstrcpyW(p, PathFindFileNameW(paths[i]));
+        p += lstrlenW(p) + 1;
+    }
+    *p = 0;
+    *name_offset = dir_len + 1;
+    *ext_offset = 0;
+    return result;
+}
+
+static BOOL store_result(FileOpenDlgInfos *info, const WCHAR *result, UINT len, UINT name_offset, UINT ext_offset)
+{
+    OPENFILENAMEW *ofn = info->ofnInfos;
+
+    if (info->unicode)
+    {
+        if (len > ofn->nMaxFile)
+        {
+            if (ofn->lpstrFile && ofn->nMaxFile >= 2) *(WORD *)ofn->lpstrFile = len;
+            COMDLG32_SetCommDlgExtendedError(FNERR_BUFFERTOOSMALL);
+            return FALSE;
+        }
+        memcpy(ofn->lpstrFile, result, len * sizeof(WCHAR));
+        ofn->nFileOffset = name_offset;
+        ofn->nFileExtension = ext_offset;
+    }
+    else
+    {
+        OPENFILENAMEA *ofna = (OPENFILENAMEA *)ofn;
+        int size = WideCharToMultiByte(CP_ACP, 0, result, len, NULL, 0, NULL, NULL);
+
+        if (size > (int)ofna->nMaxFile)
+        {
+            if (ofna->lpstrFile && ofna->nMaxFile >= 2) *(WORD *)ofna->lpstrFile = size;
+            COMDLG32_SetCommDlgExtendedError(FNERR_BUFFERTOOSMALL);
+            return FALSE;
+        }
+        WideCharToMultiByte(CP_ACP, 0, result, len, ofna->lpstrFile, ofna->nMaxFile, NULL, NULL);
+        /* the offsets count bytes */
+        ofna->nFileOffset = WideCharToMultiByte(CP_ACP, 0, result, name_offset, NULL, 0, NULL, NULL);
+        ofna->nFileExtension = ext_offset ? WideCharToMultiByte(CP_ACP, 0, result, ext_offset, NULL, 0, NULL, NULL) : 0;
+    }
+    return TRUE;
+}
+
+static BOOL get_result(FileOpenDlgInfos *info, IFileDialog *dialog, BOOL save, IFileDialogCustomize *custom,
+        BOOL has_custom_filter)
+{
+    OPENFILENAMEW *ofn = info->ofnInfos;
+    UINT count, len, name_offset, ext_offset, index;
+    WCHAR **paths, *result, *ext;
+    DWORD item;
+    BOOL ret;
+
+    paths = get_result_paths(dialog, !save && (ofn->Flags & OFN_ALLOWMULTISELECT), &count);
+    if (!count || !(result = build_result(paths, count, &len, &name_offset, &ext_offset)))
+    {
+        free_result_paths(paths, count);
+        COMDLG32_SetCommDlgExtendedError(CDERR_GENERALCODES);
+        return FALSE;
+    }
+
+    if ((ret = store_result(info, result, len, name_offset, ext_offset)))
+    {
+        if (SUCCEEDED(IFileDialog_GetFileTypeIndex(dialog, &index)))
+            ofn->nFilterIndex = has_custom_filter ? index - 1 : index;
+
+        ofn->Flags &= ~(OFN_EXTENSIONDIFFERENT | OFN_READONLY);
+        ext = PathFindExtensionW(paths[0]);
+        if (count == 1 && info->defext && (!*ext || lstrcmpiW(ext + 1, info->defext)))
+            ofn->Flags |= OFN_EXTENSIONDIFFERENT;
+        if (custom && SUCCEEDED(IFileDialogCustomize_GetSelectedControlItem(custom, IDC_OPEN_DROPDOWN, &item))
+                && item == OPEN_ITEM_READONLY)
+            ofn->Flags |= OFN_READONLY;
+
+        COMDLG32_SaveLastFolder(paths[0]);
+        if (!(ofn->Flags & OFN_NOCHANGEDIR))
+        {
+            PathRemoveFileSpecW(paths[0]);
+            SetCurrentDirectoryW(paths[0]);
+        }
+    }
+
+    free(result);
+    free_result_paths(paths, count);
+    return ret;
+}
+
+static DWORD get_dialog_options(DWORD flags, BOOL save)
+{
+    static const struct { DWORD ofn, fos; } map[] =
+    {
+        { OFN_FILEMUSTEXIST,      FOS_FILEMUSTEXIST },
+        { OFN_PATHMUSTEXIST,      FOS_PATHMUSTEXIST },
+        { OFN_OVERWRITEPROMPT,    FOS_OVERWRITEPROMPT },
+        { OFN_CREATEPROMPT,       FOS_CREATEPROMPT },
+        { OFN_NODEREFERENCELINKS, FOS_NODEREFERENCELINKS },
+        { OFN_NOVALIDATE,         FOS_NOVALIDATE },
+        { OFN_NOREADONLYRETURN,   FOS_NOREADONLYRETURN },
+        { OFN_NOTESTFILECREATE,   FOS_NOTESTFILECREATE },
+        { OFN_DONTADDTORECENT,    FOS_DONTADDTORECENT },
+        { OFN_FORCESHOWHIDDEN,    FOS_FORCESHOWHIDDEN },
+        { OFN_SHAREAWARE,         FOS_SHAREAWARE },
+    };
+    /* the current directory is handled here, as GetOpenFileName does */
+    DWORD fos = FOS_NOCHANGEDIR | FOS_FORCEFILESYSTEM;
+    UINT i;
+
+    for (i = 0; i < ARRAY_SIZE(map); i++)
+        if (flags & map[i].ofn) fos |= map[i].fos;
+    if (!save && (flags & OFN_ALLOWMULTISELECT)) fos |= FOS_ALLOWMULTISELECT;
+    return fos;
+}
+
+/*
+ * Shows the item dialog for GetOpenFileName/GetSaveFileName.
+ * Returns FALSE if the Explorer style dialog has to be used instead,
+ * otherwise *ret is the result of the call.
+ */
+BOOL FILEDLG95_ShowItemDialog(FileOpenDlgInfos *info, BOOL save, BOOL *ret)
+{
+    OPENFILENAMEW *ofn = info->ofnInfos;
+    IFileDialogCustomize *custom = NULL;
+    COMDLG_FILTERSPEC *specs;
+    IFileDialog *dialog;
+    WCHAR *folder, *name;
+    BOOL has_custom_filter;
+    UINT spec_count;
+    HRESULT hr, init;
+
+    if (!use_item_dialog(info)) return FALSE;
+
+    /* the dialog needs a single threaded apartment */
+    init = CoInitializeEx(NULL, COINIT_APARTMENTTHREADED);
+    if (init == RPC_E_CHANGED_MODE)
+    {
+        TRACE("thread is in a multithreaded apartment, using the Explorer style dialog\n");
+        return FALSE;
+    }
+
+    hr = save ? FileSaveDialog_Constructor(NULL, &IID_IFileDialog, (void **)&dialog)
+              : FileOpenDialog_Constructor(NULL, &IID_IFileDialog, (void **)&dialog);
+    if (FAILED(hr))
+    {
+        ERR("failed to create the item dialog, hr %#lx\n", hr);
+        if (SUCCEEDED(init)) CoUninitialize();
+        return FALSE;
+    }
+
+    TRACE("flags %#lx, filter index %lu, initial dir %s, file %s\n", ofn->Flags, ofn->nFilterIndex,
+            debugstr_w(info->initdir), debugstr_w(info->filename));
+
+    IFileDialog_SetOptions(dialog, get_dialog_options(ofn->Flags, save));
+    if (info->title) IFileDialog_SetTitle(dialog, info->title);
+    if (info->defext) IFileDialog_SetDefaultExtension(dialog, info->defext);
+
+    if ((specs = parse_filters(info->customfilter, info->filter, &spec_count, &has_custom_filter)))
+    {
+        IFileDialog_SetFileTypes(dialog, spec_count, specs);
+        IFileDialog_SetFileTypeIndex(dialog, has_custom_filter ? ofn->nFilterIndex + 1 : max(ofn->nFilterIndex, 1));
+    }
+
+    get_initial_location(info, &folder, &name);
+    TRACE("opening %s, file name %s\n", debugstr_w(folder), debugstr_w(name));
+    set_initial_folder(dialog, folder);
+    if (name && *name) IFileDialog_SetFileName(dialog, name);
+
+    if (!save && !(ofn->Flags & OFN_HIDEREADONLY)
+            && SUCCEEDED(IFileDialog_QueryInterface(dialog, &IID_IFileDialogCustomize, (void **)&custom)))
+        add_readonly_choice(custom);
+
+    hr = IFileDialog_Show(dialog, ofn->hwndOwner);
+    if (hr == S_OK)
+        *ret = get_result(info, dialog, save, custom, has_custom_filter);
+    else
+    {
+        if (hr != HRESULT_FROM_WIN32(ERROR_CANCELLED))
+        {
+            ERR("dialog failed, hr %#lx\n", hr);
+            COMDLG32_SetCommDlgExtendedError(CDERR_DIALOGFAILURE);
+        }
+        *ret = FALSE;
+    }
+
+    if (custom) IFileDialogCustomize_Release(custom);
+    IFileDialog_Release(dialog);
+    free(specs);
+    free(folder);
+    free(name);
+    if (SUCCEEDED(init)) CoUninitialize();
+    return TRUE;
+}
