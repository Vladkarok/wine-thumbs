static unsigned rnd(void) { static unsigned s = 12345; s = s * 1103515245 + 12345; return (s >> 8); }

/* exact area average in double precision */
static void reference(const BYTE *src, UINT sw, UINT sh, UINT dw, UINT dh, double *out)
{
    double sx = (double)sw / dw, sy = (double)sh / dh;
    for (UINT y = 0; y < dh; y++) for (UINT x = 0; x < dw; x++) for (int c = 0; c < 4; c++)
    {
        double sum = 0;
        for (UINT j = (UINT)(y * sy); j < sh && j < (y + 1) * sy; j++)
            for (UINT i = (UINT)(x * sx); i < sw && i < (x + 1) * sx; i++)
            {
                double wx = fmin(i + 1, (x + 1) * sx) - fmax(i, x * sx);
                double wy = fmin(j + 1, (y + 1) * sy) - fmax(j, y * sy);
                if (wx > 0 && wy > 0) sum += src[(j * sw + i) * 4 + c] * wx * wy;
            }
        out[(y * dw + x) * 4 + c] = sum / (sx * sy);
    }
}

int main(void)
{
    int failures = 0, cases = 0;
    double worst = 0;
    for (int t = 0; t < 3000; t++)
    {
        UINT sw = 1 + rnd() % 700, sh = 1 + rnd() % 700;
        UINT dw = 1 + rnd() % sw, dh = 1 + rnd() % sh;
        BYTE *src = malloc(sw * sh * 4);
        BOOL opaque;
        int mode = t % 3;
        for (UINT k = 0; k < sw * sh; k++)
        {
            BYTE a = mode == 2 ? rnd() & 0xff : 255;
            for (int c = 0; c < 3; c++) src[k * 4 + c] = mode == 0 ? 200 : (BYTE)((rnd() & 0xff) * a / 255);
            src[k * 4 + 3] = a;
        }
        BYTE *dst = resample(src, sw, sh, dw, dh, &opaque);
        double *ref = malloc(dw * dh * 4 * sizeof(double));
        if (t < 400) reference(src, sw, sh, dw, dh, ref);
        for (UINT k = 0; k < dw * dh * 4; k++)
        {
            double err = t < 400 ? fabs(dst[k] - ref[k]) : 0;
            if (err > worst) worst = err;
            if (err > 1.0 || (mode == 0 && dst[k] != ((k % 4 == 3) ? 255 : 200)))
            {
                if (failures++ < 5) printf("FAIL %ux%u->%ux%u mode %d idx %u got %u ref %.3f\n", sw, sh, dw, dh, mode, k, dst[k], t < 400 ? ref[k] : -1);
            }
        }
        if (mode != 2 && !opaque) { if (failures++ < 5) printf("FAIL opaque flag %ux%u->%ux%u\n", sw, sh, dw, dh); }
        cases++;
        free(src); free(dst); free(ref);
    }
    printf("%d cases, %d failures, worst error vs reference %.3f\n", cases, failures, worst);
    return failures != 0;
}
